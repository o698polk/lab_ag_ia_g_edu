# Entorno
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-jwt-secret-key-long

# Base de datos (MySQL XAMPP por defecto)
# Formato: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/laboratorioB

# Alternativa SQLite para desarrollo sin MySQL:
# DATABASE_URL=sqlite:///../database/laboratorio.db

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Seguridad
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AES_SECRET_KEY=change-me-32-byte-aes-key!!

# DeepSeek (opcional; también configurable desde admin)
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# App
SYSTEM_NAME=Sistema de Gestión Académica
ADMIN_EMAIL=admin@institucion.edu
ADMIN_PASSWORD=Admin123!
ADMIN_USERNAME=admin
