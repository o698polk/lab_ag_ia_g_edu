# Ref: BL-QA-001 | Skill: K-004 | Fase: F5
# SIGA — variables de entorno (ejemplo). Copiar a `.env` y completar localmente.
# NUNCA commitear `.env` con secretos reales.

APP_NAME=SIGA
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
APP_API_PREFIX=/api/v1

# MySQL (XAMPP local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=siga
DB_USER=root
DB_PASSWORD=
DB_DRIVER=mysql+pymysql

# JWT — reemplazar JWT_SECRET en local (mín. 32 caracteres aleatorios)
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_32PLUS
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# Password hashing: argon2 | bcrypt
PASSWORD_HASHER=argon2

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Policies (PAP)
POLICY_PATH=policies/v1

# AI provider: mock | openai | other
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# CORS (solo localhost en F5/F11)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500
